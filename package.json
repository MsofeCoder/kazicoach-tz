{
  "name": "kazicoach-tz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src functions",
    "test:db": "vitest run tests/database.test.ts --testTimeout=30000 --hookTimeout=60000",
    "lint:functions": "tsc -p tsconfig.functions.json --pretty false",
    "lint:eslint": "eslint .",
    "smoke": "node scripts/smoke.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "preview:setup": "node scripts/local-preview.mjs",
    "test:local": "node scripts/test-local-api.mjs",
    "test:watch": "vitest",
    "lint": "tsc -b --pretty false",
    "test:recovery": "node scripts/test-recovery.mjs",
    "test:release-config": "node scripts/test-release-config.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "10.13.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "^4.1.11"
