# Set these as encrypted Cloudflare Pages environment variables.
# Never expose them with a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# LOCAL TEST ONLY. Both browser hostname and endpoint must be loopback.
# npm run preview:setup writes ignored .env.local with the local publishable key.
VITE_LOCAL_ACCOUNTS=false
VITE_SUPABASE_URL=http://127.0.0.1:57421
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only local Pages Function configuration, optional and disabled by default.
LOCAL_ACCOUNTS_ENABLED=false
SUPABASE_URL=http://127.0.0.1:57421
SUPABASE_PUBLISHABLE_KEY=
