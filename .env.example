# Local development only. preview:setup writes the matching local publishable key.
VITE_LOCAL_ACCOUNTS=false
VITE_SUPABASE_URL=http://127.0.0.1:57251
VITE_SUPABASE_PUBLISHABLE_KEY=

# Explicit hosted BUILD inputs. Disabled until exact targets are approved.
# Set through the build process environment, not VITE_ values in .env.local.
KAZICOACH_RELEASE_ACCOUNTS=false
KAZICOACH_RELEASE_APP_ORIGIN=
KAZICOACH_RELEASE_SUPABASE_URL=
KAZICOACH_RELEASE_PUBLISHABLE_KEY=

# Cloudflare SERVER bindings, separate from the browser build.
# No privileged Supabase key is required by this application.
ACCOUNTS_MODE=disabled
APP_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
LOCAL_ACCOUNTS_ENABLED=false

# Paid AI remains off without an explicitly approved provider key. Billing stays disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
