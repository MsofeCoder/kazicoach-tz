# Set these as encrypted Cloudflare Pages environment variables.
# Never expose them with a VITE_ prefix.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# App version — injected automatically from package.json at build time.
# Override here only for canary/staging builds.
# VITE_APP_VERSION=

# Optional anonymous usage analytics (PostHog free tier).
# These are PUBLIC client values by design — the VITE_ prefix is required and safe.
# Without a key the app ships with analytics completely disabled (privacy-first default).
# See HOSTING.md for the full setup guide.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
